{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kraftt-admin",
  "compatibility_date": "2026-05-15",
  "main": "./admin-cloudflare/worker.ts",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "admin.krafttdigital.in", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist/admin",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kraftt-admin-data",
      "database_id": "5f73d77f-79b0-4cab-948c-981596f49a6e"
    }
  ],
  "vars": {
    "ACCESS_ACCOUNT_ID": "bb26343ad536ce42fc95a788b5725b52",
    "ACCESS_AUD": "16aea161563102dd7a7d952e4943ade0a74dde1ab3b534a11364cabd6842507c",
    "ACCESS_TEAM_DOMAIN": "twilight-grass-87d1.cloudflareaccess.com"
  }
}
